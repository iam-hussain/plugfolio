// Plugfolio database schema (MongoDB + Prisma). Migrated from PostgreSQL
// (ADR-0001 — superseded) to MongoDB Atlas. IDs are app-generated UUID strings
// mapped to `_id`, so the seed and fixtures keep their fixed IDs; the former
// composite primary keys become a generated `_id` + `@@unique`, and the
// Post<->Product link is Mongo's array-based many-to-many (id arrays on each
// side). Referential actions run in Prisma's emulation (the Mongo default).

// Generated into the workspace, not pnpm's virtual store: Next's file tracing
// won't follow the query-engine .so out of node_modules/.pnpm into a Vercel
// lambda, so the deploy builds fine and then 500s on the first query.
//
// That alone isn't enough. transpilePackages compiles this package INTO each
// app's chunks, so at runtime Prisma resolves the engine against the app dir
// (/var/task/apps/web/generated/client) rather than against this package, and
// still misses. Each Next app's build script therefore copies the engine into
// .next/server/ — one of the paths Prisma searches, and one Vercel always
// ships. Both halves are needed; drop either and the lambda 500s.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/// The login identity — what ADR-0004 calls the creator ACCOUNT (email login,
/// connects Google+Meta, holds up to 5 profiles). Named `User` because Auth.js
/// owns the identity tables (ADR-0007); anonymous shoppers are NOT rows here
/// (ADR-0002).
model User {
  id            String    @id @default(uuid()) @map("_id")
  email         String    @unique
  /// The member handle (ADR-0009, ADR-0024): every account's public identity
  /// for follow/comment, shown as @handle. A generated placeholder until the
  /// person picks one at email verification; changeable in settings. It IS a
  /// login (email or handle, same password) but never a URL in v1 — a separate
  /// namespace from Profile.username.
  username      String    @unique
  /// scrypt `salt:hash` (ADR-0012). Null = passwordless (an invited Manager
  /// before their first set-password link).
  passwordHash  String?
  emailVerified DateTime?
  name          String?
  image         String?
  /// Set by an admin (admin app): blocks login and darkens every profile the
  /// account owns. Null = active.
  suspendedAt   DateTime?
  /// Last time this account opened /following. The denominator for the
  /// "N new since you last looked" counts on that page — measured against
  /// post timestamps, never modelled. Null = never opened it.
  followingSeenAt DateTime?
  createdAt     DateTime  @default(now())
  profiles      Profile[]
  accounts      Account[]
  sessions      Session[]
  follows       Follow[]
  watches       Watch[]
  comments      Comment[]
  commentReactions CommentReaction[]
  business      Business?
  collabMessages CollabMessage[]
  managedProfiles ProfileManager[]
}

/// An Auth.js provider link — for Google/Meta this IS the "connected social"
/// of ADR-0004 (at most one of each per account, enforced in the service layer
/// when connects land).
model Account {
  id                String  @id @default(uuid()) @map("_id")
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Auth.js database session (email magic-link sign-in, ADR-0007).
model Session {
  id           String   @id @default(uuid()) @map("_id")
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Auth.js email verification token (magic links).
model VerificationToken {
  id         String   @id @default(uuid()) @map("_id")
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

/// A creator PROFILE with a social-derived username (ADR-0004).
model Profile {
  id        String    @id @default(uuid()) @map("_id")
  username  String    @unique
  /// Public identity (brief 10): shown as the page's big name; null = @username.
  displayName String?
  /// Image URL — uploaded (ADR-0023) or pasted. Null = initial-letter tile.
  avatarUrl   String?
  bio         String?
  /// Page appearance (ADR-0017) — a closed set, never a theme editor. Unset =
  /// the default (violet · balanced · grid). Values are validated by the Zod
  /// enums at the boundary; stored as strings because Mongo enums buy nothing.
  accent      String?
  headerStyle String?
  gridStyle   String?
  /// v2 appearance axes (ADR-0026): cover treatment + links-row mode. Plain
  /// strings like the rest; unset derives from the header style at the read.
  coverStyle  String?
  linkMode    String?
  /// The one line above the name ("Hey — glad you found me."). Unset = none.
  greeting    String?
  /// Set by an admin: takes just this page off the public surface (owner can
  /// still sign in). Null = live.
  suspendedAt DateTime?
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts      Post[]
  products   Product[]
  taps       Tap[]
  views      View[]
  codeCopies CodeCopy[]
  followers  Follow[]
  comments   Comment[]  @relation("PageComments")
  commentsAs Comment[]  @relation("CommentsAsProfile")
  categories Category[]
  collabs    Collab[]
  managers   ProfileManager[]
  links      ProfileLink[]
  createdAt  DateTime   @default(now())

  @@index([userId])
}

/// A creator-page social link (design-out: the socials row under the header,
/// authored in dashboard Settings → "Your links"). One per platform per
/// profile; the row renders in a fixed canonical order, so no position column.
model ProfileLink {
  id        String   @id @default(uuid()) @map("_id")
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// Zod enum at the boundary: instagram | youtube | tiktok | facebook | website.
  platform  String
  url       String
  createdAt DateTime @default(now())

  @@unique([profileId, platform])
}

/// A Manager invited to help run ONE profile (ADR-0004: one Admin — the
/// profile's owning user — plus up to 3 Managers; the cap and the two-role
/// permission split are enforced in the service layer).
model ProfileManager {
  id        String   @id @default(uuid()) @map("_id")
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([profileId, userId])
  @@index([userId])
}

/// A BUSINESS — a brand/store that hires creators (lean journey: name, what
/// you sell, a logo, an email). One business per user in v1.
model Business {
  id           String        @id @default(uuid()) @map("_id")
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  description  String
  logoUrl      String?
  requirements Requirement[]
  collabs      Collab[]
  createdAt    DateTime      @default(now())
}

/// A posted requirement (door one): the brief creators can approach on the
/// open board. Budget is free text — v1 handles no money (§2.3).
model Requirement {
  id         String   @id @default(uuid()) @map("_id")
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title      String
  brief      String
  budget     String?
  deadline   DateTime?
  /// Closed = off the open board; existing threads persist (brief 11).
  closedAt   DateTime?
  collabs    Collab[]
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// A collab thread between one business and one creator profile. Two doors:
/// creator approaches a requirement (requirementId set) or business reaches
/// out directly (requirementId null). Agreed when BOTH sides have accepted;
/// money changes hands off-platform (§2.3).
model Collab {
  id               String          @id @default(uuid()) @map("_id")
  businessId       String
  business         Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  profileId        String
  profile          Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  requirementId    String?
  requirement      Requirement?    @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  /// The live proposal (brief 12): latest Propose-terms wins and resets both
  /// agreements — "Agreed" always means agreed to THESE terms.
  termsContent     String?
  termsPrice       String?
  termsDeadline    DateTime?
  businessAgreedAt DateTime?
  creatorAgreedAt  DateTime?
  messages         CollabMessage[]
  createdAt        DateTime        @default(now())

  @@index([businessId])
  @@index([profileId])
}

/// One message in a collab thread — the bargain happens here, not in DMs.
model CollabMessage {
  id           String   @id @default(uuid()) @map("_id")
  collabId     String
  collab       Collab   @relation(fields: [collabId], references: [id], onDelete: Cascade)
  senderUserId String
  sender       User     @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  body         String
  createdAt    DateTime @default(now())

  @@index([collabId, createdAt])
}

/// A shopper following a creator profile — the first of the two social actions
/// behind the optional shopper account (§2.2: never required to shop).
model Follow {
  id        String   @id @default(uuid()) @map("_id")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, profileId])
  @@index([profileId])
}

/// A shopper saving a post or a product for later — the same door as Follow
/// (§2.2: an account, never required to shop). Polymorphic like Report, not a
/// pair of nullable FKs: Mongo indexes a missing field as null, so a
/// `@@unique([userId, postId])` would collide across every product row and
/// lose the idempotency a double-fired save needs (§6.8). The price is no
/// referential integrity — a deleted post leaves a row the read drops.
model Watch {
  id        String   @id @default(uuid()) @map("_id")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "post" | "product" — the Zod enum at the boundary is the contract.
  kind      String
  targetId  String
  createdAt DateTime @default(now())

  @@unique([userId, kind, targetId])
  @@index([userId, createdAt])
}

/// A comment on a creator's page — the second social action behind the
/// shopper account. Reading comments stays account-free.
model Comment {
  id        String   @id @default(uuid()) @map("_id")
  /// The owning creator page — always set, also for product comments.
  profileId String
  profile   Profile  @relation("PageComments", fields: [profileId], references: [id], onDelete: Cascade)
  /// ADR-0013: null = a page-level comment; set = a comment on this product.
  /// Post comments are deferred.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// ADR-0013: one-level threads — a reply's parent is always top-level
  /// (enforced in the service). Mongo's emulated referential integrity forbids
  /// a self-relation cascade, so deleting a parent's replies is the service's
  /// job now (Postgres did it at the DB level via Cascade).
  parentId  String?
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   Comment[] @relation("CommentReplies")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The profile this comment speaks AS (ADR-0009) — validated against the
  /// author's memberships in the service. Null = the personal @handle.
  /// SetNull: a deleted profile's comments fall back to the person.
  asProfileId String?
  asProfile   Profile? @relation("CommentsAsProfile", fields: [asProfileId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())

  reactions CommentReaction[]

  @@index([profileId, createdAt])
  @@index([productId, createdAt])
  @@index([parentId])
}

/// Helpful / not helpful on a COMMENT (lean journey: "a comment can be agreed
/// with"). Deliberately not a rating: it scores an answer, never a product or
/// a creator. One row per account per comment — the @@unique makes a
/// double-fired tap idempotent the way Follow does, and changing your mind is
/// an update, not a second row.
model CommentReaction {
  id        String   @id @default(uuid()) @map("_id")
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "helpful" | "unhelpful" — the Zod enum at the boundary is the contract.
  value     String
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
}

/// A creator's shelf (ADR-0010): per-profile curation, never a site-wide
/// taxonomy. Posts/products join via a single nullable FK — deleting a
/// category never deletes content.
model Category {
  id          String    @id @default(uuid()) @map("_id")
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  description String?
  sortOrder   Int       @default(0)
  posts       Post[]
  products    Product[]
  createdAt   DateTime  @default(now())

  @@unique([profileId, title])
  @@index([profileId, sortOrder])
}

/// A creator's post — the shoppable unit of the page ("tap a post, see the
/// product"). v1 has no social import yet, so rows come from seed/dashboard;
/// every row is treated as published (the publish flag lands with the tagging
/// dashboard). Post<->Product is a Mongo array-based many-to-many.
model Post {
  id        String    @id @default(uuid()) @map("_id")
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// The still: the photo for a photo post, the poster frame for a video.
  /// Always present, because the video slot loads as a facade (ADR-0019) and
  /// the poster is what a shopper sees until they press play.
  mediaUrl  String
  /// What the post IS (ADR-0019): "still" | "youtube" | "instagram" | "tiktok".
  /// Unset = a still, so every existing row keeps working untouched.
  mediaKind String?
  /// The provider's embed URL, only for a video post. Never rendered until
  /// the shopper presses play — mounting it is what sets third-party cookies.
  embedUrl  String?
  /// Where the video lives publicly ("Watch on YouTube instead"). Always
  /// offered: in-app browsers regularly refuse to play an embed at all.
  sourceUrl String?
  caption   String?
  /// Hidden by the creator (brief 07): off the public page, still in the
  /// dashboard. Null = visible.
  hiddenAt  DateTime?
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  productIds String[]
  products  Product[] @relation(fields: [productIds], references: [id])
  taps      Tap[]
  views     View[]
  codeCopies CodeCopy[]
  createdAt DateTime  @default(now())

  @@index([profileId, createdAt])
}

/// A product a creator tags (ADR-0011: outbound-only; v1 handles no money,
/// §2.3). `kind` says whose product it is; a coupon (code + channels) can ride
/// on either. Price and image are display-only metadata grabbed at tag time.
model Product {
  id            String  @id @default(uuid()) @map("_id")
  profileId     String
  profile       Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind          ProductKind @default(affiliate)
  title         String
  /// The outbound destination — retailer affiliate link (kind=affiliate) or
  /// the creator's own store (kind=own). Null = in-store-only coupon: no Buy
  /// button, the code + inStoreNote IS the buy path (ADR-0011).
  affiliateUrl  String?
  /// The product page this was read from — where the title, image and price
  /// came from. Distinct from `affiliateUrl`: a creator pastes the retailer's
  /// public page here and their own tracked link there, and the two are
  /// usually different URLs on the same site.
  sourceUrl     String?
  /// Coupon attachment: code + optional expiry + optional in-store channel.
  /// Channel rule (≥1 of affiliateUrl/inStoreNote) enforced in the service.
  couponCode    String?
  offerEndsAt   DateTime?
  inStoreNote   String?
  imageUrl      String?
  priceCents    Int?
  currency      String   @default("usd")
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  postIds       String[]
  posts         Post[]   @relation(fields: [postIds], references: [id])
  taps          Tap[]
  views         View[]
  codeCopies    CodeCopy[]
  comments      Comment[]
  createdAt     DateTime @default(now())

  @@index([profileId])
}

enum ProductKind {
  affiliate
  own
}

/// An outbound tap — immutable attribution event (§6.6, append-only). Earnings
/// are a rebuildable projection over these rows, never a mutated counter.
model Tap {
  id             String   @id @default(uuid()) @map("_id")
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  profileId      String
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// The post that drove the tap ("this reel drove 312 taps"). Nullable —
  /// profile-/product-surface taps have no post. SetNull, not Cascade: taps
  /// are append-only earnings events and must survive a post's deletion.
  postId         String?
  post           Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  /// Verified anonymous device identity (from the signed cookie), NOT an
  /// account link (§6.7, ADR-0002).
  deviceId       String
  /// Idempotency key — in-app browsers double-fire taps (§6.8).
  idempotencyKey String   @unique
  source         TapSource
  occurredAt     DateTime @default(now())

  @@index([profileId, occurredAt])
  @@index([productId, occurredAt])
  @@index([postId, occurredAt])
}

/// An internal operator of the admin app (docs/implementation/admin-app.md).
/// Deliberately NOT a product User — a product-auth bug must never escalate
/// to admin access. Rows are seeded by scripts/create-admin.ts, never sign-up.
model AdminUser {
  id           String        @id @default(uuid()) @map("_id")
  email        String        @unique
  /// scrypt `salt:hash`, same helper as product accounts (ADR-0012).
  /// Null = an invited operator who hasn't set a password yet.
  passwordHash String?
  name         String?
  lastSignInAt DateTime?
  /// Bumped on password set/change; JWTs carry it — stale = signed out.
  sessionVersion Int         @default(0)
  createdAt    DateTime      @default(now())
  actions      AdminAction[]
}

/// Append-only audit trail: every admin mutation records who did what to
/// which entity. Never updated or deleted (same discipline as Tap).
model AdminAction {
  id         String    @id @default(uuid()) @map("_id")
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  /// Verb, dot-namespaced: "member.suspend", "settings.reservedUsernames".
  action     String
  targetType String?
  targetId   String?
  /// Human-readable context ("@handle", the new value, …).
  detail     String?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
}

/// Application settings the admin app edits at runtime (reserved usernames,
/// feature flags, …). One row per key, JSON value validated by the owning
/// service in @plugfolio/core.
model AppSetting {
  key       String   @id @map("_id")
  value     Json
  updatedAt DateTime @updatedAt
}

/// A user/shopper flag on a piece of content — the admin triage queue
/// (Milestone 2). The target is a loose (type, id) pair on purpose: reports
/// must survive their target's deletion so the queue keeps its history.
model Report {
  id            String           @id @default(uuid()) @map("_id")
  targetType    ReportTargetType
  targetId      String
  category      ReportCategory
  /// The reporter's free-text note.
  note          String?
  /// "@handle" for signed-in reporters, "Anonymous shopper" otherwise —
  /// denormalized so the queue never joins on a deletable account.
  reporterLabel String           @default("Anonymous shopper")
  /// One line describing the target at report time (comment snippet, product
  /// title) — the queue's preview, stable even after takedown.
  snippet       String
  status        ReportStatus     @default(open)
  createdAt     DateTime         @default(now())
  resolvedAt    DateTime?

  @@index([status, createdAt])
}

enum ReportTargetType {
  comment
  product
  profile
  post
}

enum ReportCategory {
  spam
  scam
  offensive
  impersonation
  other
}

enum ReportStatus {
  open
  resolved
  dismissed
}

/// A support request (docs/implementation/support.md): anyone — signed in or
/// not — asks the operators for help. Known issues are the enum; `other`
/// carries the unknown ones. Email is the reply channel (no in-app threads).
model SupportTicket {
  id            String                @id @default(uuid()) @map("_id")
  category      SupportTicketCategory
  message       String
  /// The REPLY address, asked explicitly — "lost email access" means the
  /// account email is exactly the one that doesn't work.
  contactEmail  String
  /// "@handle" when signed in, "Anonymous visitor" otherwise — denormalized
  /// like Report so the queue never joins a deletable account.
  requesterLabel String               @default("Anonymous visitor")
  status        SupportTicketStatus   @default(open)
  createdAt     DateTime              @default(now())
  resolvedAt    DateTime?

  @@index([status, createdAt])
}

enum SupportTicketCategory {
  lost_email_access
  change_email
  merge_accounts
  password_trouble
  username_conflict
  connection_trouble
  /// The only door to a business account: asked for here so an operator sees
  /// who is hiring before a Business row exists (no self-serve create).
  business_account
  collab_dispute
  delete_account
  other
}

enum SupportTicketStatus {
  open
  resolved
  dismissed
}

enum TapSource {
  profile
  post
  product
}

/// A shoppable surface opening — the denominator taps were always missing.
/// 1,284 taps reads as enormous until you see 20,410 views, so the dashboard
/// never shows one without the other (docs/implementation/dashboard.md).
///
/// Append-only like Tap and CodeCopy (§6.6): the Traffic card is a rebuildable
/// projection over these rows, never a mutated counter. Nothing here is a
/// person — the device id is the same signed anonymous token taps use
/// (ADR-0002), and no view is ever attributed to an account.
model View {
  id             String     @id @default(uuid()) @map("_id")
  profileId      String
  profile        Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// Set on a post view; SetNull so the event survives the post's deletion.
  postId         String?
  post           Post?      @relation(fields: [postId], references: [id], onDelete: SetNull)
  /// Set on a product view. SetNull for the same reason.
  productId      String?
  product        Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  deviceId       String
  /// Idempotency key — in-app browsers double-fire, and React strict mode
  /// mounts the beacon twice in development (§6.8).
  idempotencyKey String     @unique
  surface        ViewSurface
  /// `document.referrer` as the browser reported it (ADR-0021); null when it
  /// sent none. Classified into named sources at the Traffic read.
  referrer       String?
  occurredAt     DateTime   @default(now())

  @@index([profileId, occurredAt])
  @@index([postId, occurredAt])
  @@index([productId, occurredAt])
}

/// Which surface opened. Mirrors TapSource so the two projections line up row
/// for row — "views · taps" on one line only reads if they count the same
/// three places.
enum ViewSurface {
  profile
  post
  product
}

/// A coupon-code copy — the second attribution event (ADR-0011), append-only
/// like Tap. In-store redemption happens beyond Plugfolio's sight, so copies
/// are the only measured signal and are labeled "redemption not tracked".
model CodeCopy {
  id             String   @id @default(uuid()) @map("_id")
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  profileId      String
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  postId         String?
  post           Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  deviceId       String
  idempotencyKey String   @unique
  occurredAt     DateTime @default(now())

  @@index([profileId, occurredAt])
  @@index([productId, occurredAt])
}

/// A sponsored placement on Explore (ADR-0020). Created by an operator in the
/// admin app and shown only while the `ads` flag is on — there is no plan, no
/// self-serve purchase and no billing; deals are agreed off-platform like
/// everything else in v1 (§2.3). No targeting: it is shown to everyone or to
/// nobody, because the shopper surface has no account to target against.
model AdPlacement {
  id          String    @id @default(uuid()) @map("_id")
  title       String
  description String?
  imageUrl    String?
  /// Where the slot goes. Outbound, like every other tap on the surface.
  url         String
  /// The window. Unset `activeUntil` = runs until an operator stops it.
  activeFrom  DateTime  @default(now())
  activeUntil DateTime?
  createdAt   DateTime  @default(now())

  @@index([activeFrom])
}
