# Admin app (ADR-0014). Copy to .env.local.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/plugfolio_dev?appName=<app>"
# 32+ chars; independent from the web app's secret.
AUTH_SECRET=change-me-to-a-32-char-minimum-secret
# Where member email links land (web app) / operator links land (this app).
WEB_ORIGIN=http://localhost:7077
ADMIN_ORIGIN=http://localhost:7078
# Real mail transport (ADR-0015); links log to the console when unset.
# An API key, not the account auth token — scoped and revocable.
# TWILIO_API_KEY_SID=SK...
# TWILIO_API_KEY_SECRET=...
# EMAIL_FROM="Plugfolio <no-reply@plugfolio.com>"
