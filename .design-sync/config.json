{
  "projectId": "acbe2039-06b0-4728-a52a-2b88125cad84",
  "shape": "storybook",
  "pkg": "@plugfolio/ui",
  "globalName": "PlugfolioUI",
  "storybookConfigDir": "apps/web/.storybook",
  "storybookStatic": ".design-sync/sb-reference",
  "cssEntry": "./dist/ds-styles.css",
  "readmeHeader": ".design-sync/conventions.md",
  "extraEntries": ["../../.design-sync/preview-shell.tsx"],
  "provider": { "component": "PreviewShell" },
  "overrides": {
    "CreatorHeader": { "cardMode": "column" },
    "PostWall": { "cardMode": "column" },
    "LoopSteps": { "cardMode": "column" },
    "MediaSlot": { "cardMode": "column" },
    "ProductDetail": { "cardMode": "column" },
    "DashCard": { "cardMode": "column" },
    "PageHeader": { "cardMode": "column" },
    "Pager": { "cardMode": "column" },
    "Panel": { "cardMode": "column" },
    "SharePanel": { "cardMode": "column" },
    "Skeleton": { "cardMode": "column" },
    "StatTile": { "cardMode": "column" },
    "Sidebar": { "cardMode": "single", "primaryStory": "AdminShell" }
  },
  "buildCmd": "pnpm -C packages/ui exec tsc -p tsconfig.json --declaration --emitDeclarationOnly --noEmit false --outDir dist --rootDir src --declarationMap false --composite false && node -e \"const fs=require('fs'),p=require('path');const d='.design-sync/sb-reference/assets';const f=fs.readdirSync(d).filter(x=>x.endsWith('.css')).map(x=>({x,s:fs.statSync(p.join(d,x)).size})).sort((a,b)=>b.s-a.s)[0];fs.copyFileSync(p.join(d,f.x),'packages/ui/dist/ds-styles.css')\"",
  "titleMap": {
    "Actionform": "ActionForm",
    "Systemscreen": "SystemScreen",
    "Themetoggle": "ThemeToggle",
    "Socialsrow": "SocialsRow",
    "Header": "CreatorHeader",
    "Sharepanel": "SharePanel",
    "Collabthread": "CollabThread",
    "Backroom": "DashCard",
    "Wall": "PostWall",
    "Persuade": "LoopSteps",
    "Media": "MediaSlot",
    "Detail": "ProductDetail",
    "Forms": "AuthForm",
    "Parts": "CommentSection",
    "Color": null,
    "Type": null,
    "Shoppertabbar": null,
    "Productcard": null,
    "Shopgrid": null,
    "Status": null,
    "Shell": null,
    "Account": null,
    "Following": null
  }
}
